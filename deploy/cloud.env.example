# Copy to deploy/cloud.env and edit. Used by deploy/deploy.sh (NOT committed: see .gitignore).
PROJECT_ID=your-gcp-project-id
REGION=asia-south1            # Mumbai: closest region to Indian government sites
REPO=rice-tracker             # Artifact Registry repo name
IMAGE_NAME=rice-tracker
BUCKET=your-gcp-project-id-rice-snapshots
WITH_BROWSER=0                # 1 = bake Chromium into the image for JS-heavy sites
TIMEZONE=Asia/Kolkata
COMMODITIES=rice,maize        # what to track

# Non-secret runtime config baked into the Cloud Run jobs
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
