# Copy to .env and fill in what you have. Everything is optional for a first local run:
# with nothing set, alerts print to the terminal and no LLM is used (keyword matching).

# ---- Telegram (see docs/LOCAL.md "Telegram setup") ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email (Gmail: use an App Password, host smtp.gmail.com, port 587) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
EMAIL_FROM=
EMAIL_TO=            # comma-separated

# ---- LLM classification (recommended; without it keyword matching is used) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ---- Storage (local defaults; cloud values in deploy/cloud.env.example) ----
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/tracker.db
SNAPSHOT_BACKEND=local
SNAPSHOT_DIR=data/snapshots

# ---- Behaviour ----
SOURCES_FILE=config/sources.yaml
MAX_WORKERS=4
HOST_MIN_INTERVAL=2
BROWSER_ENABLED=false
FAILURE_ALERT_THRESHOLD=3
